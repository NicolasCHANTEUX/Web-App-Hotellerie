# Copy the PostgreSQL URI from Supabase Dashboard > Connect.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres?sslmode=require"
DATABASE_SSL_CA="certs/prod-ca-2021.crt"

SUPABASE_URL="https://fgcqbquzqvgaynhzgbuq.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"
# Backend only. Never prefix this variable with VITE_ and never expose it to the browser.
SUPABASE_SECRET_KEY="sb_secret_replace_me"
SUPABASE_STORAGE_BUCKET="hotel-public"

PORT="3001"
NODE_ENV="development"
TRUST_PROXY="false"
CORS_ORIGIN="http://127.0.0.1:5173,http://localhost:5173"
FRONTEND_URL="http://127.0.0.1:5173"
PUBLIC_PROPERTY_SLUG="hotel-rivage"
# Generate a dedicated random value of at least 32 bytes for production.
BOOKING_ACCESS_TOKEN_SECRET="replace-with-a-long-random-secret"

# Optional services. The application stays fully usable in manual mode when
# these values are absent.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NOTIFICATION_DELIVERY="disabled"
# Keep "embedded" locally. In production, set "standalone" on API instances
# and run exactly one dedicated worker process with the same configuration.
BACKGROUND_WORKER_MODE="embedded"
RESEND_API_KEY=""
EMAIL_FROM="Votre hôtel <reservations@example.com>"
