# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY prisma.config.ts tsconfig.json ./
COPY prisma ./prisma
COPY src ./src
# Prisma needs a syntactically valid URL to generate its client; no database is contacted.
RUN DATABASE_URL=postgresql://localhost:5432/build npm run db:generate && npm run build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=80
ENV BACKGROUND_WORKER_MODE=disabled

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY certs ./certs

USER node
EXPOSE 80
CMD ["node", "dist/src/index.js"]
