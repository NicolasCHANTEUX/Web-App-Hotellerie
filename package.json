{
  "name": "hotel-figma-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.mjs --configLoader native",
    "dev:full": "node scripts/prepare-dev.mjs && concurrently -n API,WEB -c yellow,cyan \"npm --prefix server run dev\" \"npm run dev\"",
    "build": "tsc -b && vite build --config vite.config.mjs --configLoader native",
    "build:all": "npm --prefix server run build && npm run build",
    "smoke:render": "npm run build && node scripts/smoke-render.mjs",
    "smoke:admin": "npm run build && node scripts/smoke-admin-render.mjs",
    "preview": "vite preview --config vite.config.mjs --configLoader native"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "tailwindcss": "^4.1.12"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.4",
    "happy-dom": "^20.11.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
